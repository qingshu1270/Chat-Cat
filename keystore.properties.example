# 复制为 keystore.properties 后填写自己的签名信息（本文件不会被提交）
# 生成密钥：
#   keytool -genkeypair -v -keystore keystore/release.jks -alias chatcat \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -dname "CN=Chat Cat, O=Chat Cat, C=CN"
storeFile=keystore/release.jks
storePassword=your-store-password
keyAlias=chatcat
keyPassword=your-key-password
